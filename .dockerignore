# .dockerignore — tells Docker what NOT to copy into the image

# Git
.git
.gitignore

# Environment files (secrets!)
.env
.env.local
.env.production

# Python junk
__pycache__
*.py[cod]
*.egg-info
dist
build
.venv
venv
.mypy_cache
.pytest_cache
.ruff_cache

# IDE
.vscode
.idea

# Docs (not needed in production image)
*.md
!README.md
docs/

# CI/CD
.github

# OS files
.DS_Store
Thumbs.db

# Models cache (downloaded at runtime)
models/
*.pt
*.bin
