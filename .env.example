# ═══════════════════════════════════════════════════
# BEAN AI — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════

# ── Application ──
ENVIRONMENT=development          # development, staging, production
DEBUG=true
LOG_LEVEL=INFO
APP_VERSION=4.0.0

# ── Server ──
HOST=0.0.0.0
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Database (PostgreSQL 15 + pgvector) ──
DATABASE_URL=postgresql+asyncpg://bean:bean@localhost:5432/bean
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis (Memorystore) ──
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SESSION_TTL_SECONDS=86400         # 24 hours
REDIS_TTS_CACHE_TTL_SECONDS=604800      # 7 days
REDIS_RESPONSE_CACHE_TTL_SECONDS=3600   # 1 hour

# ── Google ADK / Gemini ──
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_PROJECT_ID=your_gcp_project_id
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# ── Deepgram (STT) ──
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_SAMPLE_RATE=16000
DEEPGRAM_ENCODING=linear16
DEEPGRAM_CHANNELS=1
DEEPGRAM_ENDPOINTING_MS=500
DEEPGRAM_UTTERANCE_END_MS=1000

# ── ElevenLabs (TTS) ──
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB    # BEAN voice
ELEVENLABS_MODEL_ID=eleven_turbo_v2
ELEVENLABS_CHUNK_SIZE=4096

# ── Twilio (SMS for guardian alerts) ──
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15555555555              # Your Twilio number

# ── Google OAuth 2.0 ──
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback

# ── Google Calendar ──
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar
BEAN_CALENDAR_NAME=BEAN Reminders

# ── OpenAI (Embeddings) ──
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ── Safety ──
ALERT_THRESHOLD=3                           # 3-of-5 factors for crisis
MINOR_ALERT_THRESHOLD=3                     # Effectively 2-of-4 since F4 pre-set
GUARDIAN_ALERT_COOLDOWN_SECONDS=300          # 5 min between SMS

# ── Rate Limiting ──
RATE_LIMIT_WS_MESSAGES_PER_MIN=60
RATE_LIMIT_API_CALLS_PER_MIN=100
RATE_LIMIT_LLM_CALLS_PER_HOUR=10000

# ── Background Jobs ──
REMINDER_CHECK_INTERVAL_SECONDS=60
SESSION_CLEANUP_INTERVAL_HOURS=6
EMOTION_PURGE_RETENTION_DAYS=90
EPISODIC_MEMORY_EXPIRY_DAYS=30

# ── Emotion Model ──
EMOTION_MODEL_NAME=ehcalabres/wav2vec2-lg-xlsr-en-speech-emotion-recognition
EMOTION_WINDOW_MS=500

# ── Music ──
DEFAULT_VOLUME=50
