# ============================================================================
# BEAN AI v1 — Environment Variables Template
# Copy to .env and fill in all values before running. NEVER commit .env.
# ============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend / Cookies ────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000
# Leave COOKIE_DOMAIN blank for local dev. Set to .yourdomain.com in production.
COOKIE_DOMAIN=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Google Gemini (Tiered LLM) ────────────────────────────────────────────────
# Get from: aistudio.google.com
GOOGLE_API_KEY=your-google-api-key
LLM_CHEAP_MODEL=gemini-2.0-flash
LLM_PRO_MODEL=gemini-2.5-pro

# ── Google OAuth (Calendar integration) ──────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
OAUTH_STATE_SECRET=some-random-secret-string

# ── OpenAI (Embeddings only) ───────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ── Deepgram (Speech-to-Text) ─────────────────────────────────────────────────
DEEPGRAM_API_KEY=your-deepgram-api-key

# ── ElevenLabs (Text-to-Speech) ───────────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ── Twilio (SMS crisis alerts to guardian/doctor) ─────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+1234567890

# ── Privacy & Data Retention ──────────────────────────────────────────────────
TRANSCRIPT_RETENTION_HOURS=24
EMOTION_RETENTION_DAYS=90
EPISODIC_MEMORY_RETENTION_DAYS=365
SESSION_METADATA_RETENTION_DAYS=730

# ── Safety & Rate Limiting ────────────────────────────────────────────────────
ALERT_THRESHOLD=3
GUARDIAN_ALERT_COOLDOWN_SECONDS=300
RATE_LIMIT_WS_MESSAGES_PER_MIN=60
RATE_LIMIT_API_CALLS_PER_MIN=100
RATE_LIMIT_HASH_SALT=your-random-secret-string-here