# ============================================================================
# BEAN AI v1 — Environment Variables Template
# Copy to .env and fill in all values before running. NEVER commit .env.
# ============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# WARNING: update this to your production domain(s) before deploying.
# Example for production: CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend / Cookies ────────────────────────────────────────────────────────
# WARNING: update to your production URL before deploying.
FRONTEND_BASE_URL=http://localhost:3000
# Leave COOKIE_DOMAIN blank for local dev. Set to .yourdomain.com in production.
COOKIE_DOMAIN=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Redis (conversation cache + reminder delivery) ────────────────────────────
# FIX: REDIS_URL was missing from the original .env.example despite Redis
# being required by shared/conversation_cache.py, services/redis_service.py,
# and background/reminder_check.py.
# For Docker Compose development: redis://redis:6379 (uses the service name)
# For local development without Docker: redis://localhost:6379
# For production (e.g. Upstash): rediss://:<password>@host:port
REDIS_URL=redis://localhost:6379

# ── Google Gemini (Tiered LLM) ────────────────────────────────────────────────
# Get from: aistudio.google.com
GOOGLE_API_KEY=your-google-api-key
LLM_CHEAP_MODEL=gemini-2.0-flash
LLM_PRO_MODEL=gemini-2.5-pro

# ── Google OAuth (Calendar integration) ──────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# WARNING: update redirect URI to your production domain before deploying.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# Must be at least 32 random characters. Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=some-random-secret-string-min-32-chars

# ── OpenAI (Embeddings only) ───────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ── Deepgram (Speech-to-Text) ─────────────────────────────────────────────────
DEEPGRAM_API_KEY=your-deepgram-api-key

# ── ElevenLabs (Text-to-Speech) ───────────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_turbo_v2

# ── Twilio (SMS crisis alerts to guardian/doctor) ─────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+1234567890

# ── Privacy & Data Retention ──────────────────────────────────────────────────
TRANSCRIPT_RETENTION_HOURS=24
EMOTION_RETENTION_DAYS=90
EPISODIC_MEMORY_RETENTION_DAYS=365
SESSION_METADATA_RETENTION_DAYS=730

# ── Safety & Alert Thresholds ─────────────────────────────────────────────────
# Number of active safety factors required to trigger a guardian SMS alert.
# Adults need 3 of 5 factors. Minors need only 2 (F4 vulnerability is pre-set).
ALERT_THRESHOLD=3
MINOR_ALERT_THRESHOLD=2
# Minimum seconds between repeated guardian SMS alerts for the same user.
GUARDIAN_ALERT_COOLDOWN_SECONDS=300

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WS_MESSAGES_PER_MIN=60
RATE_LIMIT_API_CALLS_PER_MIN=100
# Must be a long random string. Generate with: openssl rand -hex 32
# NEVER leave this blank in production — unsalted hashing is insecure.
RATE_LIMIT_HASH_SALT=your-random-secret-string-here

# ── Internal Admin API ────────────────────────────────────────────────────────
# Required. Protects the POST /internal/purge and GET /internal/health endpoints.
# If blank, /internal/* returns 503. Generate with: openssl rand -hex 32
# NEVER expose this value publicly or include it in client-side code.
INTERNAL_API_KEY=your-long-random-internal-secret-here