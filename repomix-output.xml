# ============================================================================
# BEAN AI v1 — Docker Compose (Local Development)
# Note: State lives in Supabase Cloud. No local DB container needed.
# ============================================================================
services:
  bean-api:
    # Build configuration
    build:
      context: .                    # Build context is current directory
      dockerfile: Dockerfile        # Use the main Dockerfile
      target: development           # Use the 'development' stage from multi-stage Dockerfile

    container_name: bean-api        # Name of the container

    # Port mapping: host:container
    ports:
      - "8080:8080"                 # Expose API port for local dev

    # Environment variables from file
    env_file:
      - .env                        # Load secret keys, API tokens, etc.

    # Inline environment variables (overrides .env if duplicated)
    environment:
      - ENVIRONMENT=development     # Flag for dev environment
      - DEBUG=true                   # Enable debug logging
      - LOG_LEVEL=DEBUG              # Log level for detailed output

    # Volumes for live code updates and local caches
    volumes:
      - .:/app                       # Mount current directory for live-reload
      - /app/__pycache__             # Persist Python cache (optional)
      - /app/.venv                   # Persist virtual environment (optional)

    # Healthcheck ensures container is ready and responsive
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8080/api/v1/health')"]
      interval: 30s                  # How often to run healthcheck
      timeout: 10s                   # Max time for one check
      retries: 3                     # Number of failures before unhealthy
      start_period: 15s              # Initial grace period before starting checks

    # Restart policy for local dev convenience
    restart: unless-stopped          # Restart unless explicitly stopped
