        assert result["routing_failure_reason"] == "timeout"


# ---------------------------------------------------------------------------
# Observability — diagnostics always written
# ---------------------------------------------------------------------------


class TestDiagnosticsAlwaysWritten:
    @pytest.mark.asyncio
