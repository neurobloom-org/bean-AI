        """Map current emotion to appropriate music genre."""
        emotion_genre_map = {
            "sad": "calm",
            "fearful": "calm",
            "angry": "calm",
            "disgusted": "calm",
            "happy": "happy",
            "surprised": "happy",
            "calm": "lofi",
            "neutral": "lofi",
        }
